{
  "version": 1,
  "$comment": "First run for new and returning users (bipe-chat/bipe#415, ADR 0072, ADR 0113). One source for the start screen, the sign-up steps, the recovery rows and the later prompts on iOS and Android. `start`: the start screen variant per state; exactly one variant matches each pair of `invitePending` (an invite came from a link or a deferred install) and `inviteRequired` (GET /v1/signup/config). Every screen has one `primary` (filled) button and zero or more `text` buttons. `to` is a step key, `recovery`, `waitlist` or `create` (POST /v1/signup). `steps` are the sign-up screens in order. `recovery` rows are in screen order; `when` names the state that shows a row; `gate` is `planned:<issue>` for a row that stays hidden until bipe-chat/bipe#<issue> ships. `prompts` come after the account exists; `trigger` says when. `chatListWithoutRecovery` (bipe#531): GET /v1/me/account says independent_recovery false, the account is at least accounts.json recoveryReminder.firstAfterDays old on this phone and the snooze ended; the handle card goes first, one card at a time (spec recovery-reminder). Titles and bodies are bipe_* string keys.",
  "start": [
    {
      "key": "invited",
      "invitePending": true,
      "inviteRequired": null,
      "title": "bipe_onboarding_invited_by",
      "primary": { "title": "bipe_onboarding_join_with_invite", "to": "name" },
      "text": [{ "title": "bipe_onboarding_have_account", "to": "recovery" }]
    },
    {
      "key": "inviteOnly",
      "invitePending": false,
      "inviteRequired": true,
      "title": "bipe_onboarding_title",
      "primary": { "title": "bipe_onboarding_have_invite", "to": "inviteCode" },
      "text": [{ "title": "bipe_onboarding_have_account", "to": "recovery" }]
    },
    {
      "key": "open",
      "invitePending": false,
      "inviteRequired": false,
      "title": "bipe_onboarding_title",
      "primary": { "title": "bipe_signup_title", "to": "name" },
      "text": [{ "title": "bipe_onboarding_have_account", "to": "recovery" }]
    }
  ],
  "steps": [
    {
      "key": "inviteCode",
      "title": "bipe_invite_code_title",
      "body": "bipe_invite_code_body",
      "primary": { "title": "bipe_action_continue", "to": "name" },
      "text": [{ "title": "bipe_invite_code_none", "to": "waitlist" }]
    },
    {
      "key": "name",
      "title": "bipe_signup_name_title",
      "primary": { "title": "bipe_action_continue", "to": "pin" },
      "text": []
    },
    {
      "key": "pin",
      "title": "bipe_pin_create_title",
      "body": "bipe_pin_create_body",
      "primary": { "title": "bipe_action_continue", "to": "fallback" },
      "text": []
    },
    {
      "key": "fallback",
      "title": "bipe_fallback_title",
      "body": "bipe_fallback_body",
      "primary": { "title": "bipe_fallback_email", "to": "create" },
      "text": [{ "title": "bipe_fallback_skip", "to": "create" }]
    }
  ],
  "waitlist": {
    "body": "bipe_waitlist_body",
    "primary": { "title": "bipe_waitlist_join", "to": "waitlist" },
    "done": "bipe_waitlist_done"
  },
  "created": "bipe_signup_device_success",
  "recovery": [
    { "key": "token", "title": "bipe_pin_enter_title", "body": "bipe_recovery_token_found", "when": "syncedToken" },
    { "key": "oldPhone", "title": "bipe_recovery_qr", "body": "bipe_recovery_qr_body", "gate": "planned:203" },
    { "key": "email", "title": "bipe_recovery_email", "body": "bipe_recovery_email_body" },
    { "key": "beta", "title": "bipe_recovery_beta", "body": "bipe_recovery_beta_body", "gate": "flag:developer" }
  ],
  "prompts": [
    {
      "key": "notifications",
      "trigger": "firstMessageSent",
      "title": "bipe_notifications_prompt_title",
      "body": "bipe_notifications_prompt_body",
      "primary": { "title": "bipe_notifications_prompt_allow", "to": "systemPermission" },
      "text": [{ "title": "bipe_fallback_skip", "to": "dismiss" }]
    },
    {
      "key": "handle",
      "trigger": "chatListWithoutHandle",
      "title": "bipe_handle_prompt_title",
      "body": "bipe_handle_prompt_body",
      "primary": { "title": "bipe_handle_prompt_action", "to": "handleScreen" },
      "text": [{ "title": "bipe_fallback_skip", "to": "dismiss" }]
    },
    {
      "key": "recovery",
      "trigger": "chatListWithoutRecovery",
      "title": "bipe_fallback_title",
      "body": "bipe_fallback_reminder",
      "primary": { "title": "bipe_fallback_email", "to": "recoveryEmailAdd" },
      "text": [{ "title": "bipe_fallback_skip", "to": "dismiss" }]
    }
  ],
  "firstList": {
    "$comment": "Cards at the top of Conversas while it lists at most maxChats chats (bipe-chat/bipe#198, spec chat-list-cards). A card goes away for good once used or dismissed.",
    "maxChats": 3,
    "cards": [
      {
        "key": "invite",
        "title": "bipe_first_card_invite_title",
        "body": "bipe_first_card_invite_body",
        "primary": { "title": "bipe_first_card_invite_action", "to": "shareInvite" },
        "text": [{ "title": "bipe_fallback_skip", "to": "dismiss" }]
      },
      {
        "key": "profile",
        "when": "hasHandle",
        "title": "bipe_first_card_profile_title",
        "body": "bipe_first_card_profile_body",
        "primary": { "title": "bipe_app_share", "to": "shareProfile" },
        "text": [{ "title": "bipe_profile_qr_action", "to": "profileQr" }, { "title": "bipe_fallback_skip", "to": "dismiss" }]
      },
      {
        "key": "notes",
        "title": "bipe_self_chat_title",
        "body": "bipe_first_card_notes_body",
        "primary": { "title": "bipe_first_card_notes_action", "to": "notes" },
        "text": [{ "title": "bipe_fallback_skip", "to": "dismiss" }]
      }
    ]
  }
}
