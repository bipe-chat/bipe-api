{
  "version": 1,
  "safeSchemes": [
    "https",
    "http",
    "mailto",
    "tel",
    "matrix"
  ],
  "dropContentTags": [
    "script",
    "style",
    "iframe",
    "object",
    "embed",
    "svg",
    "math",
    "template",
    "mx-reply"
  ],
  "boldTags": [
    "b",
    "strong"
  ],
  "italicTags": [
    "i",
    "em"
  ],
  "strikeTags": [
    "s",
    "del",
    "strike"
  ],
  "codeTags": [
    "code",
    "pre"
  ],
  "blockTags": [
    "p",
    "div",
    "pre",
    "blockquote"
  ],
  "linkPattern": "https?://[^\\s<>]+|www\\.[^\\s<>]+|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
  "phonePattern": "(?<![A-Za-z0-9])(?:\\+[0-9][0-9 ().-]{6,}[0-9]|\\([0-9]{2,3}\\)[ ]*[0-9][0-9 -]{6,}[0-9]|[0-9]{10,15})(?![A-Za-z0-9])",
  "maxHtmlLength": 131072,
  "maxDepth": 64
}
