{
  "$comment": "On-device money-request detection (security.md rule 9). Friction, not protection: attackers can read these rules. Regexes use a portable ASCII subset: [0-9] not \\\\d, explicit (?<![0-9A-Za-z]) / (?![0-9A-Za-z]) instead of \\\\b, because ICU (Swift) and Java treat \\\\d and \\\\b as Unicode-aware while JS does not. Phrases are compared after normalisation. Starter list: review before launch. Warning kind: the first kind in warningKindPriority whose rule applies. pixKey applies only when the normalised message also contains a pixKeyContextWords entry (a phone number or e-mail alone is normal chat). newNumber applies when a matched urgency phrase is in newNumberPhrases (the falso parente opener).",
  "version": 1,
  "pixKeyPatterns": [
    {
      "id": "cpf",
      "regex": "(?<![0-9A-Za-z])[0-9]{3}\\.?[0-9]{3}\\.?[0-9]{3}-?[0-9]{2}(?![0-9A-Za-z])"
    },
    {
      "id": "cnpj",
      "regex": "(?<![0-9A-Za-z])[0-9]{2}\\.?[0-9]{3}\\.?[0-9]{3}/?[0-9]{4}-?[0-9]{2}(?![0-9A-Za-z])"
    },
    {
      "id": "phone",
      "regex": "(?<![0-9])(?:\\+?55\\s?)?\\(?[1-9]{2}\\)?\\s?9[0-9]{4}-?[0-9]{4}(?![0-9])"
    },
    {
      "id": "email",
      "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
    },
    {
      "id": "random",
      "regex": "(?<![0-9A-Za-z])[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![0-9A-Za-z])"
    }
  ],
  "pixCopyPastePatterns": [
    {
      "id": "brcode",
      "regex": "000201.*(?i:br\\.gov\\.bcb\\.pix)"
    }
  ],
  "boletoPatterns": [
    {
      "id": "linha-digitavel",
      "regex": "(?<![0-9A-Za-z])[0-9]{5}\\.?[0-9]{5}\\s?[0-9]{5}\\.?[0-9]{6}\\s?[0-9]{5}\\.?[0-9]{6}\\s?[0-9]\\s?[0-9]{14}(?![0-9A-Za-z])"
    }
  ],
  "urgencyPhrases": [
    "troquei de numero",
    "numero novo",
    "esse e meu numero novo",
    "salva esse numero",
    "faz um pix",
    "faz um pix pra mim",
    "preciso de um pix",
    "me empresta",
    "me empresta um dinheiro",
    "urgente",
    "e urgente",
    "hoje ainda",
    "agora mesmo",
    "nao posso falar agora",
    "nao consigo falar agora",
    "depois te explico",
    "te devolvo amanha",
    "te pago amanha",
    "meu app do banco travou",
    "me passa o codigo",
    "codigo que chegou",
    "aprova esse login",
    "escaneia esse qr"
  ],
  "receiptKeywords": [
    "comprovante",
    "pix enviado",
    "transferencia realizada",
    "pagamento efetuado",
    "id da transacao"
  ],
  "pixKeyContextWords": [
    "pix",
    "chave"
  ],
  "newNumberPhrases": [
    "troquei de numero",
    "numero novo",
    "esse e meu numero novo",
    "salva esse numero"
  ],
  "warningKindPriority": [
    "pixCode",
    "boleto",
    "pixKey",
    "receipt",
    "newNumber",
    "urgency"
  ]
}
