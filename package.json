{
  "name": "bipe-api",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p .",
    "test:attest": "pnpm build && node --test test/attest.test.mjs test/key-attest.test.mjs test/config.test.mjs test/signup-quota.test.mjs test/weblink.test.mjs test/support.test.mjs test/govbr.test.mjs test/transfer.test.mjs",
    "test:integration": "pnpm build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:scheduling": "pnpm build && node --test test/scheduling.test.mjs",
    "test:real": "pnpm build && node --env-file=test/real/.stack/env --test --test-concurrency=1 test/real/*.test.mjs",
    "start": "node dist/server.js",
    "gen": "node ../bipe-shared/tools/gen.mjs"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@matrix-org/matrix-sdk-crypto-nodejs": "0.6.6",
    "asn1js": "3.0.10",
    "hono": "4.13.13",
    "mmdb-lib": "3.0.3",
    "pg": "8.23.1",
    "pkijs": "3.4.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@matrix-org/matrix-sdk-crypto-nodejs"
    ]
  }
}
